# Aspect Window Cleaning - Environment Variables
# Duplicate this file to .env.local and fill in the values

# Google Analytics 4 (GA4) Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID
# From Clarity Dashboard -> Settings -> Overview
NEXT_PUBLIC_CLARITY_ID=

# Resend API - Email Service
# Get key from https://resend.com/api-keys
RESEND_API_KEY=

# Internal Email Configuration
# Where quote requests should be sent TO
MY_EMAIL=info@aspectwindowcleaning.com.au

# Verified Sender Email
# Must be verified in Resend dashboard
# Format: Onboarding <onboarding@resend.dev> OR Your Name <you@yourdomain.com>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=info@aspectwindowcleaning.com.au
NEXT_PUBLIC_CONTACT_PHONE=04XX XXX XXX
NEXT_PUBLIC_GMB_URL=https://g.page/your-business

# Brevo Api Key
BREVO_API=

# ClickSend Telephony & SMS (Perth, WA based - Recommended)
# Get credentials from https://dashboard.clicksend.com/#/account/subaccounts
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_PHONE_NUMBER=04XXXXXXXX

# Telnyx Telephony & SMS (Alternative)
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+614XXXXXXXX

# Twilio Telephony & SMS (Alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+614XXXXXXXX

# Priority Escalation Alerts (Where urgent out-of-scope SMS go)
AHMED_ALERT_PHONE=+614XXXXXXXX

# AI Brain API Key (Gemini 2.5 Flash / 2.0 Flash)
GEMINI_API_KEY=

