# Aspect Window Cleaning - Environment Variables
# Duplicate this file to .env.local and fill in the values

# Google Analytics 4 (GA4) Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID
# From Clarity Dashboard -> Settings -> Overview
NEXT_PUBLIC_CLARITY_ID=

# Resend API - Email Service
# Get key from https://resend.com/api-keys
RESEND_API_KEY=

# Internal Email Configuration
# Where quote requests should be sent TO
MY_EMAIL=hello@aspect.com.au

# Verified Sender Email
# Must be verified in Resend dashboard
# Format: Onboarding <onboarding@resend.dev> OR Your Name <you@yourdomain.com>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=hello@aspect.com.au
NEXT_PUBLIC_CONTACT_PHONE=04XX XXX XXX
NEXT_PUBLIC_GMB_URL=https://g.page/your-business
