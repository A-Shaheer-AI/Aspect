# ==============================================================================
# ASPECT WINDOW CLEANING - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# For Vercel Production / Staging:
# Add these variables in the Vercel Dashboard:
# Project -> Settings -> Environment Variables.
#
# For Local Development:
# Copy this file to .env.local and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE EDGE CACHING & PURGE INTEGRATION
# ------------------------------------------------------------------------------

# CLOUDFLARE_ZONE_ID:
# 32-character hexadecimal string identifying aspectwindowcleaning.com.au on Cloudflare.
# Where to find it:
# 1. Log in to dash.cloudflare.com
# 2. Click on domain "aspectwindowcleaning.com.au"
# 3. On the "Overview" page, scroll down the right sidebar to "API" section
# 4. Copy "Zone ID"
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# CLOUDFLARE_API_TOKEN:
# Cloudflare API Bearer token for programmatic cache purging and rule verification.
# How to create it:
# 1. In Cloudflare dashboard, click profile icon (top right) -> "My Profile"
# 2. Click "API Tokens" -> "Create Token"
# 3. Click "Create Custom Token":
#    - Token name: "Aspect Vercel Edge Purge"
#    - Permissions:
#        * Zone | Cache Purge | Purge
#        * Zone | Zone Settings | Read (optional, for SSL verification)
#    - Zone Resources:
#        * Include | Specific zone | aspectwindowcleaning.com.au
# 4. Click "Continue to summary" -> "Create Token" -> Copy token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# CLOUDFLARE_PURGE_SECRET:
# A private secret passphrase created by you to protect the /api/cache/purge route
# from unauthorized external requests.
# Generate any secure random string or UUID (e.g. "aspect-purge-9f82b7c4d1e0").
CLOUDFLARE_PURGE_SECRET=your_custom_secure_purge_secret_here

# ------------------------------------------------------------------------------
# 2. SITE & NOTIFICATIONS CONFIGURATION
# ------------------------------------------------------------------------------

# Public canonical site URL
NEXT_PUBLIC_SITE_URL=https://aspectwindowcleaning.com.au

# Brevo (Sendinblue) API Key for lead & CRM syncing
# BREVO_API=xkeysib-...

# Resend API Key for notification emails
# RESEND_API_KEY=re_...

# ------------------------------------------------------------------------------
# 3. BABYLOVEGROWTH HEADLESS BLOG INTEGRATION
# ------------------------------------------------------------------------------
# Integration key from Settings -> Integrations -> Next.js Blog in BabyLoveGrowth dashboard.
# Keep server-side only. Do NOT add NEXT_PUBLIC_ prefix.
BABYLOVEGROWTH_BLOG_API_KEY=your_babylovegrowth_api_key_here
BABYLOVEGROWTH_BLOG_API_URL=https://api.babylovegrowth.ai/api/integrations/v1

# ------------------------------------------------------------------------------
# 4. OPINLY BLOG & ANALYTICS INTEGRATION
# ------------------------------------------------------------------------------
# Secret API Key from Opinly Dashboard -> Settings -> Developers
# Keep server-side only. Do NOT add NEXT_PUBLIC_ prefix.
OPINLY_API_KEY=your_opinly_api_key_here

# Webhook signing secret for content cache invalidation from Opinly Dashboard -> Settings -> Developers
OPINLY_WEBHOOK_SIGNING_SECRET=your_opinly_webhook_signing_secret_here


